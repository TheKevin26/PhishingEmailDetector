# ---------- Detector ----------
# auto = use model chosen at training time | classic | transformer | ensemble
PHISHGUARD_MODEL=auto
PHISHGUARD_THRESHOLD=0.5
# Protect the REST API (clients must send header  X-API-Key: <value>)
PHISHGUARD_API_KEY=
# Connectors call a remote PhishGuard API instead of loading the model locally (optional)
PHISHGUARD_API_URL=

# ---------- IMAP (any provider) ----------
# Gmail/Yahoo/iCloud/Outlook.com need an APP PASSWORD (not your normal password)
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
# IMAP_HOST is auto-detected for common providers; set it for custom/company servers
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=3
IMAP_MOVE_PHISHING=false
IMAP_PHISHING_FOLDER=Phishing

# ---------- Gmail API ----------
GMAIL_CREDENTIALS=secrets/gmail_credentials.json
GMAIL_TOKEN=secrets/gmail_token.json
GMAIL_MOVE_TO_SPAM=false

# ---------- Outlook / Microsoft 365 (Graph) ----------
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common
OUTLOOK_MOVE_TO_JUNK=false
